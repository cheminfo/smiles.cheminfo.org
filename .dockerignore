.claude
.env
# The build reads the commit it was made from out of these three,
# which is what the About page shows. Nothing else of .git is sent.
.git
!.git/HEAD
!.git/refs
!.git/packed-refs
.github
compose*.yaml
**/coverage
**/dist
# Not a bare `node_modules`: that anchors to the root only, and the workspace
# copies would then be layered over what `npm ci` installs inside the image —
# a macOS build of a native package landing in a linux container.
**/node_modules
**/playwright-report
**/test-results
