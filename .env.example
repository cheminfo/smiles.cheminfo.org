# Copy this file to .env.
# Local dev: leave COMPOSE_FILE commented, then npm run dev.
# Docker:    uncomment one COMPOSE_FILE line, then docker compose up -d.

# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# The image the compose files run, and the tag they run of it. `docker compose
# build` tags what it builds with exactly this pair, so a tag that never moves
# would leave each build overwriting the one before it and a rollback with
# nothing left to roll back to. Give a build a tag of its own —
# 20260815T094500Z-a1b2c3d — and the image it replaced is still reachable by
# name. IMAGE_TAG is rewritten by the deploy tooling; do not edit it by hand.
IMAGE_NAME=ghcr.io/cheminfo/smiles.cheminfo.org
IMAGE_TAG=latest

# Port the site is served on. The Vite dev server takes the one above it, and
# does not read this file: export PORT or VITE_PORT in the shell to move it.
PORT=10814

# Analytics. The snippet the provider hands out, pasted whole and on one line:
# the container puts it at the end of the <head> of every page it serves — one
# file per address is written by the build, so a visitor is counted whichever
# one they arrived at. Unset — a dev run, or a
# deployment that measures nothing — nothing is loaded. Each site has its own
# id, from https://datami.cheminfo.org — never copy another project's.
# TRACKING_SCRIPT=<script defer src="https://datami.cheminfo.org/script.js" data-website-id="847be179-5562-4fe6-9510-939be36cd2dc"></script>

# Cloudflare Tunnel token (compose.cloudflared.yaml only).
# TUNNEL_TOKEN=
