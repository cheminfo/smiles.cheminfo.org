{
  "name": "smiles",
  "version": "0.0.0",
  "description": "Structure ⇄ SMILES conversion, search and exercises, in the browser",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/cheminfo/smiles.cheminfo.org#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/smiles.cheminfo.org.git"
  },
  "bugs": {
    "url": "https://github.com/cheminfo/smiles.cheminfo.org/issues"
  },
  "license": "MIT",
  "author": "Luc Patiny",
  "scripts": {
    "build": "vite build",
    "check-deploy": "node node_modules/react-cheminfo/bin/check-deploy.mjs",
    "check-tokens": "node node_modules/react-cheminfo/bin/check-tokens.mjs src",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test-only && npm run check-types && npm run check-tokens && npm run check-deploy && npm run eslint && npm run prettier",
    "test-e2e": "playwright test",
    "test-e2e-ui": "playwright test --ui",
    "test-only": "vitest run --coverage"
  },
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "^9.39.5",
    "eslint-config-zakodium": "^20.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "volta": {
    "node": "24.14.0"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@blueprintjs/icons": "^6.13.0",
    "@preact/signals-react": "^3.12.0",
    "atom-sorter": "^2.2.1",
    "openchemlib": "^9.25.0",
    "openchemlib-utils": "^8.18.0",
    "papaparse": "^5.6.0",
    "react": "^19.2.8",
    "react-cheminfo": "^0.12.0",
    "react-dom": "^19.2.8",
    "react-mf": "^3.1.1",
    "react-ocl": "^8.7.2",
    "react-science": "^23.0.0",
    "react-window": "^2.3.0",
    "sdf-creator": "^4.0.0",
    "sdf-parser": "^9.0.0",
    "smart-array-filter": "^5.0.0"
  }
}
