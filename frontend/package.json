{
  "name": "smiles-frontend",
  "version": "0.0.0",
  "description": "React frontend for the SMILES conversion, search and exercise service",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "preview": "vite preview --host 0.0.0.0",
    "test-e2e": "playwright test",
    "test-e2e-ui": "playwright test --ui",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@blueprintjs/icons": "^6.13.0",
    "@preact/signals-react": "^3.12.0",
    "openchemlib": "^9.25.0",
    "openchemlib-utils": "^8.18.0",
    "papaparse": "^5.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-mf": "^3.1.1",
    "react-ocl": "^8.7.2",
    "react-window": "^2.3.0",
    "sdf-creator": "^4.0.0",
    "sdf-parser": "^9.0.0",
    "smart-array-filter": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@zakodium/tsconfig": "^1.0.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "volta": {
    "extends": "../package.json"
  }
}
